[Unit]
Description=Solana Dormant Token Revival Radar
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/solana-dormant-pump-scanner
EnvironmentFile=/root/solana-dormant-pump-scanner/.env
ExecStart=/usr/bin/python3 -u dormant_pump_scanner.py radar --interval 12
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
